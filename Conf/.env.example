# Copie este archivo como ".env" (en la misma carpeta que manage.py)
# y complete los valores. El archivo .env NO se sube al repositorio.

# Genere una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambie-esta-clave

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=BDD_PBDD
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
